# Google OAuth Configuration (Get from Google Cloud Console)
# For iOS: GOOGLE_IOS_CLIENT_ID = iOS client ID
# For Android: GOOGLE_ANDROID_CLIENT_ID = Android client ID
# For both mobile platforms: GOOGLE_SERVER_CLIENT_ID = Web client ID
# For web: GOOGLE_CLIENT_ID = Web client ID
GOOGLE_CLIENT_ID=988596890235-q4jdj3eu4r74tik21dlstolgsco2oel7.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=988596890235-1oeoj6d55l9f5gbenkmicfpej66es9rp.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=988596890235-kpmi1r85r8dget30bdvpdv345objrjgb.apps.googleusercontent.com
GOOGLE_SERVER_CLIENT_ID=988596890235-q4jdj3eu4r74tik21dlstolgsco2oel7.apps.googleusercontent.com

# Outlook OAuth Configuration (Get these from Azure Portal -> App Registrations)
# For Tenant ID: use 'common' so both Entra ID and personal Microsoft accounts can sign in
OUTLOOK_TENANT_ID=common
# For Client ID: Application (client) ID
OUTLOOK_CLIENT_ID=3f5aa18f-ec86-4602-9f2a-d6841ce63166
# For Redirect URI: Add this exact URI to Azure Portal -> App Registrations -> Authentication
# For local dev: http://localhost:5000 (or the /callback variant if configured)
# Note: You must add this URI to your Azure AD app registration for OAuth to work
OUTLOOK_REDIRECT_URI=http://localhost:5000
# Android Redirect URI (must match the signing certificate of the APK you run)
# Debug build for this workspace uses the local debug keystore fingerprint
OUTLOOK_ANDROID_REDIRECT_URI=msauth://com.example.matchme/U1UB%2FHJuOwCKJr2hJC9nTaxlr6w%3D

# Cloudflare Turnstile dev test key (Always passes, visible widget)
# TURNSTILE_SECRET_KEY is already stored in Supabase Edge secrets
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# RevenueCat API Keys (In-App Purchases / Subscriptions)
# Get these from RevenueCat Dashboard → Apps → (Select app) → API Keys
# Android key: Google Play Store app in RevenueCat
REVENUECAT_API_KEY_ANDROID=
# iOS key: App Store Connect app in RevenueCat
REVENUECAT_API_KEY_IOS=
# Web key: RevenueCat Stripe / Web integration (optional)
REVENUECAT_API_KEY_WEB=
