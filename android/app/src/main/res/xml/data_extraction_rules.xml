<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ data extraction rules (mirrors backup_rules.xml).
  Blocks cloud backup AND device-to-device transfer for sensitive storage.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
        <exclude domain="sharedpref" path="matchme_secure_prefs.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="matchme_prefs.xml"/>
        <exclude domain="database" path="."/>
        <exclude domain="file" path="hive_boxes/"/>
        <!-- Notification tray avatars (plain JPEG faces); see backup_rules.xml. -->
        <exclude domain="file" path="no_backup/notification_avatars/"/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
        <exclude domain="sharedpref" path="matchme_secure_prefs.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="matchme_prefs.xml"/>
        <exclude domain="database" path="."/>
        <exclude domain="file" path="hive_boxes/"/>
        <!-- Notification tray avatars (plain JPEG faces); see backup_rules.xml. -->
        <exclude domain="file" path="no_backup/notification_avatars/"/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
