<?xml version="1.0" encoding="utf-8"?>
<!-- Shown from process start until Flutter draws its first frame. Must match
     lib/widgets/startup_loader.dart: same logo size, same gap, same tagline
     proportions, so the handoff is invisible. Regenerate launch_lockup.png if
     the tagline or logo changes. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Use a solid white background so status bar area matches app color during launch -->
    <item android:drawable="@android:color/white" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_lockup" />
    </item>
</layer-list>
