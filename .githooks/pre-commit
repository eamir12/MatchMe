#!/usr/bin/env bash
set -euo pipefail
echo "Pre-commit: running dart fixes and flutter analyze"

if ! command -v dart >/dev/null 2>&1; then
  echo "ERROR: 'dart' not found in PATH. Install Dart SDK and ensure 'dart' is available." >&2
  exit 1
fi

if ! command -v flutter >/dev/null 2>&1; then
  echo "ERROR: 'flutter' not found in PATH. Install Flutter and ensure 'flutter' is available." >&2
  exit 1
fi

echo "Running: dart fix --apply"
dart fix --apply

# Re-stage only the paths that were already staged (dart fix may have
# rewritten some of them). Deliberately NOT `git add -A`: that would sweep
# every unrelated working-tree edit and untracked file into the commit.
git diff --cached --name-only --diff-filter=ACMR \
  | xargs -d '\n' --no-run-if-empty git add --

echo "Running: flutter analyze"
if ! flutter analyze; then
  echo "flutter analyze failed — please fix analyzer errors before committing." >&2
  exit 1
fi

echo "Pre-commit checks passed."
exit 0
